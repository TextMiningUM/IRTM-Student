    "trajectory_id": "faraday_traj_008",
    "task": "Retrieve information about Faraday's discovery of diamagnetic substances in the 1845 Experimental Researches. What substance showed the clearest diamagnetic effect, how was it oriented, and how strong was the effect compared to iron?",
    "chunks_required": ["faraday_027"],
    "steps": [
      {
        "step": 1,
        "type": "plan",
        "thought": "I need chunk faraday_027 about diamagnetics (Series XIX–XX, Volume III, 1845). Bismuth is the key substance, equatorial orientation, and the 1/3400 comparison to iron."
      },
      {
        "step": 2,
        "type": "retrieve",
        "query": "diamagnetics bismuth equatorial orientation repelled electromagnet 1/3400 iron 1845",
        "retrieved_chunk_ids": ["faraday_027"],
        "rationale": "faraday_027 covers diamagnetics, Series XIX Volume III."
      },
      {
        "step": 3,
        "type": "extract",
        "chunk_id": "faraday_027",
        "extracted_facts": [
          "Bismuth rod repelled by both poles of a strong electromagnet",
          "Bismuth suspended between poles set itself equatorially (perpendicular to field axis)",
          "Iron sets itself axially (along field axis)",
          "Repulsive force on bismuth ≈ 1/3,400 of attractive force on equal volume of iron",
          "Faraday termed these substances 'diamagnetics'",
          "Other diamagnetics found: antimony, phosphorus, arsenic",
          "Diamagnetics acquire induced magnetic polarity opposite to inducing field",
          "Series XIX–XX, Volume III, 1845 — not Volume I"
        ]
      },
      {
        "step": 4,
        "type": "synthesise",
        "answer": "Faraday's discovery of diamagnetics appears in Series XIX–XX of the Experimental Researches (Volume III, 1845), not in Volume I. He found that bismuth (and many other non-magnetic substances) is repelled by both poles of a strong electromagnet — the exact opposite of iron's behaviour. A bismuth rod suspended by a thin thread between the poles of a powerful electromagnet set itself equatorially: perpendicular to the line joining the poles, at right angles to the magnetic axis. An iron rod, by contrast, set itself axially. Faraday measured the repulsive force on bismuth as approximately 1/3,400 of the attractive force on an equivalent volume of iron in the same field. He concluded that diamagnetics acquire an induced magnetic polarity opposite in sense to the inducing field (unlike iron and paramagnetics, whose induced polarity aligns with the field), and he coined the name 'diamagnetics' for this new class. He also observed diamagnetism in antimony, phosphorus, and arsenic."
      }
    ],
    "evaluation_rubric": {
      "bismuth_equatorial_orientation": 1,
      "repelled_by_both_poles": 1,
      "1_3400_of_iron": 1,
      "opposite_polarity_definition": 1,
      "volume_III_attribution": 1
    },
    "difficulty": "hard"
