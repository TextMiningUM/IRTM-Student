[
  {
    "trajectory_id": "faraday_traj_001",
    "task": "Retrieve information about Faraday's iron-ring electromagnetic induction experiment and explain why the galvanometer deflection was transient.",
    "chunks_required": ["faraday_001"],
    "steps": [
      {
        "step": 1,
        "type": "plan",
        "thought": "The question asks about Faraday's iron-ring experiment and the transient nature of the induced current. I need to retrieve the chunk covering Series I §1–6."
      },
      {
        "step": 2,
        "type": "retrieve",
        "query": "iron ring electromagnetic induction transient galvanometer deflection",
        "retrieved_chunk_ids": ["faraday_001"],
        "rationale": "The iron-ring discovery is in Series I §1–6, chunk faraday_001."
      },
      {
        "step": 3,
        "type": "extract",
        "chunk_id": "faraday_001",
        "extracted_facts": [
          "Iron ring: seven-eighths of an inch thick, six inches in external diameter",
          "Coil A: three lengths totalling about 72 feet; connected to 100 pairs of plates",
          "Coil B: two lengths of about 60 feet each; connected to galvanometer",
          "Deflection transient: on completing circuit, needle deflects and returns; on breaking, deflects opposite and returns",
          "Faraday §6: 'the effects on the needle were not permanent, but were merely indications of the sudden change in the electromagnetic condition of the coil'",
          "No deflection while current was flowing steadily"
        ]
      },
      {
        "step": 4,
        "type": "synthesise",
        "answer": "Faraday's iron ring was seven-eighths of an inch thick and six inches in external diameter. He wound coil A (about 72 feet of wire, connected to a battery of 100 pairs) and coil B (about 120 feet of wire, connected to a galvanometer) around it. On closing the primary circuit a transient galvanometer deflection occurred; on opening the circuit a deflection in the opposite direction occurred. While the primary current was steady there was no deflection at all. The deflection was transient because induction depends on change: in §6 Faraday noted that 'the effects on the needle were not permanent, but were merely indications of the sudden change in the electromagnetic condition of the coil at the moments of making and breaking the circuit.' Only a changing magnetic flux induces an EMF; a steady flux does not."
      }
    ],
    "evaluation_rubric": {
      "ring_dimensions": 1,
      "transient_explanation": 1,
      "faraday_quote_or_paraphrase": 1,
      "correct_series_reference": 1
    },
    "difficulty": "hard"
  },
