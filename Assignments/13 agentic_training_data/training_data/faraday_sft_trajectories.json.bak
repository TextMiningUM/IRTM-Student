    "trajectory_id": "faraday_traj_006",
    "task": "Compare the specific inductive capacities of shell-lac and sulphur as measured by Faraday. What numerical values did he report, and what was the significance of the difference between insulators?",
    "chunks_required": ["faraday_020", "faraday_021"],
    "steps": [
      {
        "step": 1,
        "type": "plan",
        "thought": "A multi-hop question about two SIC measurements: shell-lac (faraday_020, §1252–1260) and sulphur (faraday_021, §1275–1280). I need to retrieve both and compare."
      },
      {
        "step": 2,
        "type": "retrieve",
        "query": "specific inductive capacity shell-lac 1.558 176 113 dielectric constant Series XI",
        "retrieved_chunk_ids": ["faraday_020"],
        "rationale": "faraday_020 covers the shell-lac SIC measurement."
      },
      {
        "step": 3,
        "type": "retrieve",
        "query": "specific inductive capacity sulphur 280 degrees 162 degrees 2.24 Series XI",
        "retrieved_chunk_ids": ["faraday_021"],
        "rationale": "faraday_021 covers the sulphur SIC measurement."
      },
      {
        "step": 4,
        "type": "extract",
        "chunk_id": "faraday_020",
        "extracted_facts": [
          "Shell-lac SIC = 176/113 = 1.558 relative to air",
          "Measured by dividing a charge between one hemisphere apparatus with shell-lac and one with air",
          "Result unexpected in its amount"
        ]
      },
      {
        "step": 5,
        "type": "extract",
        "chunk_id": "faraday_021",
        "extracted_facts": [
          "Sulphur: initial reading 280 degrees; after division with sulphur apparatus: 162 degrees retained",
          "SIC of sulphur approximately 2.24 relative to air",
          "Higher than shell-lac (1.558)"
        ]
      },
      {
        "step": 6,
        "type": "synthesise",
        "answer": "Faraday measured the specific inductive capacity (SIC) of shell-lac in §1252–1260 by charging one inductive hemisphere filled with shell-lac and dividing the charge with a complementary air hemisphere. The shell-lac apparatus retained 176 degrees against 113 degrees for the air apparatus, giving SIC(shell-lac) = 176/113 ≈ 1.558 relative to air. For sulphur (§1275–1280), the initial charge was 280 degrees; after division with the sulphur apparatus it retained 162 degrees, yielding SIC(sulphur) ≈ 2.24 relative to air — higher than shell-lac. The significance was profound: prior electrical theory assumed all insulators were equivalent. Faraday proved for the first time that different dielectric materials have intrinsically different capacities for supporting induction, a finding later central to Maxwell's electromagnetic field theory and to the design of capacitors."
      }
    ],
    "evaluation_rubric": {
      "shell_lac_SIC_176_113_1558": 1,
      "sulphur_SIC_280_162_approx_224": 1,
      "sulphur_higher_than_shell_lac": 1,
      "significance_insulators_not_equivalent": 1
    },
    "difficulty": "hard"
  },
