[
  {
    "id": "faraday_q001",
    "category": "specific_fact",
    "source": "Faraday Series I §1–6",
    "question": "In Faraday's original 1831 iron-ring experiment, what were the exact dimensions of the iron ring, and why was the induced galvanometer deflection transient rather than sustained?",
    "gold_answer": "The iron ring was seven-eighths of an inch thick and six inches in external diameter. The deflection was transient because induction only occurs during a change in the primary current: while the battery current was steady, the galvanometer needle returned to zero. Faraday noted this in §6.",
    "expected_points": [
      "seven-eighths of an inch thick",
      "six inches in external diameter",
      "deflection transient because induction requires change not steady state",
      "needle returned to zero when current was steady (§6)"
    ],
    "difficulty": "hard"
  },
  {
    "id": "faraday_q002",
    "category": "specific_fact",
    "source": "Faraday Series I §10–11",
    "question": "How long was the helix wire Faraday used in §10 to show that a permanent magnet was unnecessary for electromagnetic induction, and what essential condition did he identify?",
    "gold_answer": "Faraday used a helix wound from 203 feet of copper wire. The essential condition was change (flux change): neither a steady current nor a steady magnet produced any induction; only a changing current produced the transient deflection.",
    "expected_points": [
      "203 feet of wire wound into a helix",
      "essential condition is change or flux change",
      "permanent magnet not necessary",
      "steady current produces no deflection"
    ],
    "difficulty": "hard"
  },
